# Copy to .env and fill in.

# Your Cloudflare zone (required)
CF_DOMAIN=example.com

# Password for the web page (HTTP basic auth; any username works). Strongly recommended.
UI_PASSWORD=change-me

# Optional: pick a tunnel by name if the account has more than one.
# Default is the first healthy tunnel.
# CF_TUNNEL=my-tunnel

# Optional: the API token can go here instead of secrets/cf_token.
# CF_API_TOKEN=
